{
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm --filter @mindfoldhq/trellis-core build && pnpm --filter trellis-enhance build",
    "build:core": "pnpm --filter @mindfoldhq/trellis-core build",
    "build:cli": "pnpm --filter trellis-enhance build",
    "test": "pnpm --filter @mindfoldhq/trellis-core test && pnpm --filter trellis-enhance test",
    "test:core": "pnpm --filter @mindfoldhq/trellis-core test",
    "test:cli": "pnpm --filter trellis-enhance test",
    "test:coverage": "pnpm --filter @mindfoldhq/trellis-core test:coverage && pnpm --filter trellis-enhance test:coverage",
    "lint": "pnpm --filter @mindfoldhq/trellis-core lint && pnpm --filter trellis-enhance lint",
    "typecheck": "pnpm --filter @mindfoldhq/trellis-core build && pnpm --filter trellis-enhance typecheck",
    "release": "pnpm --filter trellis-enhance release",
    "release:minor": "pnpm --filter trellis-enhance release:minor",
    "release:major": "pnpm --filter trellis-enhance release:major",
    "release:check": "node packages/cli/scripts/release-preflight.js check-versions"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
